<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TC Lottery Prediction Pro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .number-ball {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }
        .main-ball {
            background: linear-gradient(135deg, #ff9900, #ff6600);
            color: white;
        }
        .bonus-ball {
            background: linear-gradient(135deg, #3366ff, #0033cc);
            color: white;
        }
        .method-card {
            transition: all 0.3s;
            cursor: pointer;
        }
        .method-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .method-card.active {
            border: 2px solid #4CAF50;
        }
    </style>
</head>
<body>
    <div class="container py-5">
        <div class="text-center mb-5">
            <h1 class="display-4">🎰 TC Lottery Prediction Pro</h1>
            <p class="lead">Advanced lottery number prediction using statistical analysis</p>
        </div>

        <div class="row mb-4">
            <div class="col-md-8 mx-auto">
                <div class="card shadow">
                    <div class="card-body">
                        <h5 class="card-title">Select Prediction Method</h5>
                        <form action="/predict" method="post" id="predictionForm">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <div class="card method-card p-3 text-center" onclick="selectMethod('weighted')">
                                        <h5>Weighted Random</h5>
                                        <p>Numbers weighted by frequency</p>
                                        <input type="radio" name="method" value="weighted" checked hidden>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <div class="card method-card p-3 text-center" onclick="selectMethod('hot_cold')">
                                        <h5>Hot & Cold</h5>
                                        <p>Mix of frequent and rare numbers</p>
                                        <input type="radio" name="method" value="hot_cold" hidden>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <div class="card method-card p-3 text-center" onclick="selectMethod('random')">
                                        <h5>Pure Random</h5>
                                        <p>Completely random selection</p>
                                        <input type="radio" name="method" value="random" hidden>
                                    </div>
                                </div>
                            </div>
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="bi bi-magic"></i> Generate Prediction
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-body">
                        <h5 class="card-title">How It Works</h5>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">1. Analyzes past 100 lottery draws</li>
                            <li class="list-group-item">2. Calculates number frequencies</li>
                            <li class="list-group-item">3. Applies selected prediction algorithm</li>
                            <li class="list-group-item">4. Generates optimized number combinations</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-body">
                        <h5 class="card-title">Data Status</h5>
                        <p>Last updated: <span id="lastUpdated">Loading...</span></p>
                        <button class="btn btn-outline-primary" onclick="updateData()">
                            <i class="bi bi-arrow-clockwise"></i> Update Lottery Data
                        </button>
                        <div class="mt-3">
                            <div class="progress">
                                <div id="dataProgress" class="progress-bar" role="progressbar" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-light py-3 mt-5">
        <div class="container text-center">
            <p class="text-muted small">Disclaimer: This application is for entertainment purposes only. There is no guarantee of winning any lottery. Please play responsibly.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function selectMethod(method) {
            document.querySelectorAll('.method-card').forEach(card => {
                card.classList.remove('active');
            });
            event.currentTarget.classList.add('active');
            document.querySelector(`input[value="${method}"]`).checked = true;
        }

        function updateData() {
            const progress = document.getElementById('dataProgress');
            progress.style.width = '0%';
            progress.classList.remove('bg-success', 'bg-danger');
            progress.classList.add('progress-bar-animated');
            
            fetch('/update_data')
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'success') {
                        progress.style.width = '100%';
                        progress.classList.remove('progress-bar-animated');
                        progress.classList.add('bg-success');
                        document.getElementById('lastUpdated').textContent = new Date().toLocaleString();
                    } else {
                        progress.style.width = '100%';
                        progress.classList.remove('progress-bar-animated');
                        progress.classList.add('bg-danger');
                    }
                });
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelector('.method-card').classList.add('active');
            document.getElementById('lastUpdated').textContent = new Date().toLocaleString();
        });
    </script>
</body>
</html>
